{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Master Refactored",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "masterv.cpp",
                "-I.",
                "-I/usr/include/eigen3",
                "./virtuoseAPI.so",
                "-Wl,-rpath,${workspaceFolder}/Master",
                "-o",
                "masterv",
                "-pthread"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Master"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Slave Refactored",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "slavev.cpp",
                "examples_common.cpp",
                "-I.",
                "-I/usr/include/eigen3",
                "-o",
                "slavev",
                "-lfranka",
                "-pthread"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Slave"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Refactored Master and Slave",
            "dependsOn": [
                "Build Master Refactored",
                "Build Slave Refactored"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}